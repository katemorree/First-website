# ─────────────────────────────────────────────────────────────
# Copy these into Vercel → Project → Settings → Environment Variables.
# Leave a value empty to switch that feature off. Never commit real keys.
# ─────────────────────────────────────────────────────────────

# Your live domain, no trailing slash. Used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification code (only the content="..." value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Meta (Facebook/Instagram) Pixel ID (numbers only)
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Shows small amber "Verify" markers next to facts that still need checking.
# Set to "false" once you have verified every platform fact and score.
NEXT_PUBLIC_SHOW_DRAFT_MARKERS=true

# Newsletter: Buttondown API key (https://buttondown.com → Settings → API). Server-only, never NEXT_PUBLIC.
BUTTONDOWN_API_KEY=
